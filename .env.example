# Copie para .env. Em produção, IXC_MOCK=false e chaves aleatórias (openssl rand -hex 24).

# true usa dados fictícios e, se MCP_KEYS estiver vazio, as chaves de demonstração do README.
IXC_MOCK=true

# URL do IXC, com ou sem /webservice/v1 no final.
IXC_BASE_URL=https://ixc.seudominio.com.br
# Token do usuário de API, no formato id:hash. Nunca commitar o valor real.
IXC_TOKEN=6:substitua_pelo_token

# true só se o IXC usar certificado autoassinado.
IXC_INSECURE_TLS=false
# json (padrão, igual ao curl da wiki) ou form (igual à coleção Postman).
IXC_BODY_FORMAT=json

IXC_TIMEOUT_MS=15000
IXC_MAX_RETRIES=2
IXC_RETRY_BASE_MS=200
IXC_MAX_PAGE_SIZE=50
IXC_DEFAULT_PAGE_SIZE=20
IXC_SUMMARY_MAX_RECORDS=500
IXC_MIN_INTERVAL_MS=50
IXC_MAX_CONCURRENCY=4

# Mascara CPF/CNPJ e telefone para todos os perfis exceto admin.
MASK_PII=true
BUSINESS_TIMEZONE=America/Sao_Paulo

HOST=0.0.0.0
PORT=3000
# true quando o Dokploy/Traefik preenche X-Forwarded-For.
TRUST_PROXY=true

# Limite por chave de setor e limite por IP.
RATE_LIMIT_PER_MINUTE=60
IP_RATE_LIMIT_PER_MINUTE=600

# JSON no ambiente OU caminho de arquivo. O arquivo tem prioridade se MCP_KEYS_FILE estiver definido.
# MCP_KEYS_FILE=/app/config/profiles.json
# MCP_KEYS=[{"name":"infra","profile":"infraestrutura","key":"troque-esta-chave-infra"},{"name":"financeiro","profile":"financeiro","key":"troque-esta-chave-financeiro"},{"name":"vendas","profile":"vendas","key":"troque-esta-chave-vendas"},{"name":"juridico","profile":"juridico","key":"troque-esta-chave-juridico"},{"name":"admin","profile":"admin","key":"troque-esta-chave-admin"}]
