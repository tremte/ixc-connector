{
  "name": "ixc-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor MCP remoto, somente leitura, para o IXC Provedor.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
